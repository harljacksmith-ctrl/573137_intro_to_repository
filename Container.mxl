% clear up all variables
clear all;
close all;
clc;

% define input parameters

%gravitational constant 
g = 9.81 ;

s = 1.0 ;
rho = 1000;

% loss coefficient [ pa s^2/kg^2 ]  
c1 = 1000 ;

% initial water level [m]
h0 = 4;

% calculate the parameters 
alpha = -sqrt(g/s^2/rho/c1) ;
c1_prime = sqrt(h0) ;

t_e = -2*sqrt(h0)/alpha ;

%solution

t_past = linspace(-0.2*t_e , 0 , 1001) ;

t0 = 0 ;
t1 = t_e ;
t = linspace(t0,t1,1001);

h = alpha^2*(t.^2)/4 + alpha*t*sqrt(h0) + h0;

h_ave = (h0*t_e + (alpha^2*t_e^3)/12 + (alpha*sqrt(h0)*t_e^2)/2)/(t_e - t0) ;

disp({' the average height is ', mean(h)});

disp({ 'The numerical average height is ', h_ave});

plot(t,h)
hold on 
plot(t_past, h0*ones(size(t_past)), "r" )
xlim([-0.2*t_e,t_e])
ylim([0, 1.05*h0])

xlabel('Time [s]')
ylabel('Water level [m]')
title('Water level evolution')